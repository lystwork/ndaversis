# ===================================
# Ndaversis AI Provider Configuration
# ===================================
# Configure at least one AI provider for enhanced documentation generation.
# The system will automatically fallback through the chain if primary provider fails.
# Fallback order: Gemini → Groq → OpenRouter → Mistral → DeepSeek → Qwen → Llama

# Primary Provider (Recommended: Gemini - has generous free tier)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback Providers (Optional but recommended for reliability)
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
QWEN_API_KEY=your-qwen-api-key-here
LLAMA_API_KEY=your-together-ai-key-here

# Optional: Custom API endpoints (leave empty to use defaults)
GEMINI_API_BASE=
GROQ_API_BASE=
OPENROUTER_API_BASE=
MISTRAL_API_BASE=
DEEPSEEK_API_BASE=
QWEN_API_BASE=
LLAMA_API_BASE=https://api.together.xyz/v1

# Optional: Custom models (leave empty to use defaults from config.json)
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=
DEEPSEEK_MODEL=
QWEN_MODEL=
LLAMA_MODEL=

# ===================================
# How to get API keys:
# ===================================
# Gemini: https://aistudio.google.com/ (Free tier available)
# Groq: https://console.groq.com/ (Free tier available)
# OpenRouter: https://openrouter.ai/ (Pay-as-you-go)
# Mistral: https://console.mistral.ai/ (Free tier available)
# DeepSeek: https://platform.deepseek.com/ (Requires balance)
# Qwen: https://dashscope.aliyuncs.com/ (Alibaba Cloud)
# Llama (Together AI): https://api.together.xyz/ (Free tier available)

# ===================================
# Rate Limiting
# ===================================
# The system enforces a global rate limit of 4 requests per minute
# across all providers to avoid quota exhaustion.
# This is configured in config.json and cannot be overridden via env vars.
